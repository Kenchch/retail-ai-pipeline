__pycache__/
.pytest_cache/
.venv/

# Data is downloaded or generated, never committed.
data/raw/*
!data/raw/.gitkeep
data/processed/
data/staging/
data/warehouse/
# One directory per run, plus the pointer naming the published one.
data/runs/
data/CURRENT

# The runtime layout - reports/runs/<run_id>/ and the reports/CURRENT pointer
# that names the published one - is generated, and stays out of git.
#
# The three files at the top of reports/ ARE committed: they are a copy of the
# published version, kept so a reader does not have to clone and run the
# pipeline to see what it produces. Each one names its run_id, so a reader can
# always tell which version they are looking at.
reports/*
!reports/.gitkeep
!reports/data_quality_report.md
!reports/adoption_report.md
!reports/run_metrics.json
reports/runs/
reports/failed_runs/
reports/CURRENT
