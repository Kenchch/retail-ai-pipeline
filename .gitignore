__pycache__/
.pytest_cache/
.venv/

# Data is downloaded or generated, never committed.
data/raw/*
!data/raw/.gitkeep
data/processed/
data/staging/
data/warehouse/

# The two reports ARE committed - a reader should not have to clone and run the
# pipeline to see what it produces.
reports/*
!reports/.gitkeep
!reports/data_quality_report.md
!reports/adoption_report.md
!reports/run_metrics.json
reports/failed_runs/
