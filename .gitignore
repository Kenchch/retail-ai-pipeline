__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Data is downloaded, never committed.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/warehouse/*
!data/warehouse/.gitkeep

# Generated run artefacts. The reports are deliberately committed - they are
# the readable output of a run, and a reader should not have to clone and
# execute the pipeline to see what it produces. The heavyweight data layers
# above stay out.
reports/*
!reports/.gitkeep
!reports/data_quality_report.md
!reports/run_metrics.json
!reports/adoption_dashboard.html

# Workshop deck QA renders (regenerate with soffice + pdftoppm). The PDF export
# is kept: GitHub previews PDFs in the browser and does not preview .pptx, so
# without it nobody reads the deck without downloading it first.
workshop/slide-*.jpg
