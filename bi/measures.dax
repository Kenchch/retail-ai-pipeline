// =========================================================================
// Retail sales semantic model - measure library
//
// Paste each measure into Power BI Desktop (Home > New measure), or import
// the whole file with Tabular Editor (File > Preferences > allow unsupported
// features, then Advanced Scripting).
//
// Home table for every measure below is the empty table `_Measures`
// (Home > Enter data, one column, delete the column after loading). Measures
// living on a fact table sort into the field list next to columns nobody
// should drag into a visual; a dedicated table keeps the two apart.
//
// Conventions:
//   - Every additive measure guards against blank so a card shows 0, not
//     empty, when a filter legitimately selects nothing.
//   - Format strings are noted in a comment; set them in the ribbon.
//   - DIVIDE is used everywhere instead of "/" - it returns blank on a zero
//     denominator rather than an error that breaks the whole visual.
// =========================================================================


// -------------------------------------------------------------------------
// 1. Base measures - sales
// -------------------------------------------------------------------------

// Format: £#,##0 ; expected grand total 10,247,353.28
Revenue =
SUM ( fact_sales[Revenue] )

// Format: #,##0
Units Sold =
SUM ( fact_sales[Quantity] )

// Format: #,##0 ; expected grand total 19,773
// InvoiceNo is a degenerate dimension on the fact, so orders is a distinct
// count rather than a row count on a dimension table.
Orders =
DISTINCTCOUNT ( fact_sales[InvoiceNo] )

// Format: #,##0 ; expected grand total 522,566
Sales Lines =
COUNTROWS ( fact_sales )

// Format: #,##0
// The guest member is excluded deliberately: -1 is one key standing in for
// 131,418 anonymous rows, so counting it as a customer would be wrong by
// roughly the number of guests. `Orders` still includes their orders.
Customers =
CALCULATE (
    DISTINCTCOUNT ( fact_sales[CustomerKey] ),
    KEEPFILTERS ( dim_customer[IsGuest] = FALSE )
)

// Format: #,##0
Products Sold =
DISTINCTCOUNT ( fact_sales[ProductKey] )


// -------------------------------------------------------------------------
// 2. Derived rates
// -------------------------------------------------------------------------

// Format: £#,##0.00 ; expected grand total 518.25
Average Order Value =
DIVIDE ( [Revenue], [Orders] )

// Format: #,##0.0
Units per Order =
DIVIDE ( [Units Sold], [Orders] )

// Format: £#,##0.00
// Weighted by quantity. AVERAGE(fact_sales[UnitPrice]) would weight a single
// unit of a £10 item the same as a pallet of a 50p item - a number that looks
// like an average price and answers no question anyone asked.
Average Selling Price =
DIVIDE ( [Revenue], [Units Sold] )

// Format: #,##0.0
Lines per Order =
DIVIDE ( [Sales Lines], [Orders] )

// Format: £#,##0
// Revenue per trading day, not per calendar day: the retailer is shut on
// Saturdays, and dividing by calendar days understates a normal week by a
// seventh for no reason.
Revenue per Trading Day =
VAR TradingDays =
    CALCULATE ( COUNTROWS ( dim_date ), dim_date[IsTradingDay] = TRUE )
RETURN
    DIVIDE ( [Revenue], TradingDays )


// -------------------------------------------------------------------------
// 3. Time intelligence
//
// These require dim_date to be marked as the date table
// (Table tools > Mark as date table > Date). Until it is, DATESYTD and
// SAMEPERIODLASTYEAR silently return wrong results at year boundaries rather
// than erroring.
//
// Caveat worth knowing before showing these to anyone: the source data runs
// 2010-12-01 to 2011-12-09. The calendar spans 2010-01-01 to 2011-12-31 so
// the functions are correct, but a like-for-like year-on-year comparison only
// exists for December. Everything else compares 2011 against an empty 2010,
// which is why [Revenue YoY %] is written to return blank rather than +100%
// when the prior period has nothing in it.
// -------------------------------------------------------------------------

// Format: £#,##0
Revenue YTD =
TOTALYTD ( [Revenue], dim_date[Date] )

// Format: £#,##0
Revenue MTD =
TOTALMTD ( [Revenue], dim_date[Date] )

// Format: £#,##0
Revenue LY =
CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( dim_date[Date] ) )

// Format: +0.0%;-0.0%
// Blank, not a growth figure, when there is no prior period to compare
// against. Reporting "+100%" against a zero base is the single most common
// way a YoY tile lies.
Revenue YoY % =
VAR Prior = [Revenue LY]
RETURN
    IF ( NOT ISBLANK ( Prior ) && Prior <> 0, DIVIDE ( [Revenue] - Prior, Prior ) )

// Format: £#,##0
// Rolling 3 months to the last date in context. DATESINPERIOD is used rather
// than a hand-rolled date filter so it stays correct at month ends of
// unequal length.
Revenue R3M =
CALCULATE (
    [Revenue],
    DATESINPERIOD ( dim_date[Date], MAX ( dim_date[Date] ), -3, MONTH )
)

// Format: £#,##0
// Cumulative within whatever the visual is showing. ALLSELECTED, not ALL:
// with ALL a running total on a report page filtered to 2011 would start from
// the 2010 opening balance and every point on the line would be too high.
Revenue Running Total =
CALCULATE (
    [Revenue],
    FILTER (
        ALLSELECTED ( dim_date[Date] ),
        dim_date[Date] <= MAX ( dim_date[Date] )
    )
)


// -------------------------------------------------------------------------
// 4. Contribution and ranking
// -------------------------------------------------------------------------

// Format: 0.0%
// Denominator respects slicers but ignores the row's own dimension, so the
// column sums to 100% within the visual.
Revenue % of Total =
DIVIDE (
    [Revenue],
    CALCULATE ( [Revenue], ALLSELECTED ( ) )
)

// Format: 0.0%
Revenue % of Country =
DIVIDE (
    [Revenue],
    CALCULATE ( [Revenue], ALLSELECTED ( dim_product ), ALLSELECTED ( dim_customer ) )
)

// Format: #,##0
// Ranked within the products actually on the page. DENSE so two products on
// identical revenue do not push the next one down two places.
Product Revenue Rank =
IF (
    NOT ISBLANK ( [Revenue] ),
    RANKX ( ALLSELECTED ( dim_product[Description] ), [Revenue], , DESC, DENSE )
)

// Format: 0.0%
// Concentration check: what share of revenue the top 20% of products carry.
// A single number that tells a merchandiser more about the catalogue than any
// bar chart of it.
Revenue Share of Top 20% Products =
VAR Ranked =
    ADDCOLUMNS (
        ALLSELECTED ( dim_product[ProductKey] ),
        "@rev", [Revenue],
        "@rank", RANKX ( ALLSELECTED ( dim_product[ProductKey] ), [Revenue], , DESC )
    )
VAR N = COUNTROWS ( FILTER ( Ranked, [@rev] > 0 ) )
VAR TopSlice = FILTER ( Ranked, [@rank] <= N * 0.2 )
RETURN
    DIVIDE ( SUMX ( TopSlice, [@rev] ), SUMX ( Ranked, [@rev] ) )


// -------------------------------------------------------------------------
// 5. Guest checkout
//
// A quarter of sales lines have no customer id. Any customer-sliced visual
// silently excludes them, so the model exposes the gap as a number instead of
// letting the reader assume it is not there.
// -------------------------------------------------------------------------

// Format: £#,##0 ; expected grand total 1,510,677.49
Guest Revenue =
CALCULATE ( [Revenue], dim_customer[IsGuest] = TRUE )

// Format: 0.0% ; expected grand total 14.7%
Guest Revenue % =
DIVIDE (
    [Guest Revenue],
    CALCULATE ( [Revenue], REMOVEFILTERS ( dim_customer ) )
)

// Format: £#,##0
Identified Revenue =
CALCULATE ( [Revenue], dim_customer[IsGuest] = FALSE )


// -------------------------------------------------------------------------
// 6. Data quality
//
// fact_quarantine is the second fact table. It shares dim_date, dim_product
// and dim_country with fact_sales, so a quality page responds to the same
// slicers as the sales pages.
//
// The bridge makes rule a many-to-many: a rejected row can break several
// rules at once (1.59 on average). Two consequences the report has to respect:
//   - Rejected Rows sliced by rule does NOT sum to the total. That is correct,
//     not a bug, and the page says so on the visual.
//   - Rule Violations does sum, because its grain IS one row per violation.
// -------------------------------------------------------------------------

// Format: #,##0 ; expected grand total 19,343
// Written against the bridge, not the fact, so it responds to a rule filter
// without needing a bidirectional relationship into the fact table.
Rejected Rows =
DISTINCTCOUNT ( bridge_quarantine_rule[QuarantineKey] )

// Format: #,##0 ; expected grand total 30,739
Rule Violations =
COUNTROWS ( bridge_quarantine_rule )

// Format: #,##0.00 ; expected grand total 1.59
Rules Broken per Rejected Row =
DIVIDE ( [Rule Violations], [Rejected Rows] )

// Format: £#,##0 ; expected grand total -499,605
// Net, and negative, because the rejected pile is dominated by cancellations
// and returns carrying negative quantities. That sign is the point: it is the
// reason these rows cannot be added to the sales fact, and a quality page
// that showed a tidy positive number would be hiding it.
// TREATAS pushes the bridge's row selection onto the fact without a
// bidirectional relationship - see MODEL.md for why that is worth avoiding.
Rejected Value =
CALCULATE (
    SUM ( fact_quarantine[RejectedValue] ),
    TREATAS (
        VALUES ( bridge_quarantine_rule[QuarantineKey] ),
        fact_quarantine[QuarantineKey]
    )
)

// Format: #,##0 ; expected grand total 541,909
// The denominator for the rate below. Deliberately spans both facts: the
// question "what proportion of the extract did we reject" is meaningless
// against either one alone.
Rows Extracted =
[Sales Lines] + [Rejected Rows]

// Format: 0.00% ; expected grand total 3.57%
// The pipeline fails the run above 30% (config.yaml > quality >
// max_quarantine_rate), so this tile has a meaning beyond curiosity: it is
// the number that decides whether last night's load happened at all.
Quarantine Rate % =
DIVIDE ( [Rejected Rows], [Rows Extracted] )

// Format: 0.00%
// Distance to the configured kill switch, for a gauge visual.
Quarantine Rate vs Threshold =
[Quarantine Rate %] - 0.30

// Format: #,##0
// Rows caught by rules that only report - missing description, missing
// customer id. They load; they are not rejected. Kept as a separate measure
// so nobody reads "flagged" as "lost".
Blocking Rules =
CALCULATE (
    COUNTROWS ( dim_quality_rule ),
    dim_quality_rule[Action] = "Quarantine"
)


// -------------------------------------------------------------------------
// 7. Housekeeping
// -------------------------------------------------------------------------

// Format: text
// Surfaced on every page footer. A dashboard with no refresh stamp gets
// trusted on a day the refresh failed, which is the only day it matters.
Last Refresh =
"Data through "
    & FORMAT ( CALCULATE ( MAX ( fact_sales[Date] ), REMOVEFILTERS ( ) ), "d MMM yyyy" )
    & "  ·  refreshed "
    & FORMAT ( UTCNOW (), "d MMM yyyy HH:mm" )
    & " UTC"

// Format: text
// Shown on a card on the security test page so it is obvious, when viewing as
// a role, which identity the filters are being applied for.
Viewing As =
"Signed in as: " & USERPRINCIPALNAME ( )

// Format: text
// Guard text for visuals that legitimately have no rows, so the reader sees a
// sentence instead of an empty rectangle they will read as a broken report.
No Data Message =
IF (
    ISBLANK ( [Revenue] ),
    "No sales in the selected period. The retailer is shut on Saturdays.",
    ""
)


// =========================================================================
// 8. Row-level security - role definitions
//
// Not measures. Create under Modelling > Manage roles.
//
// Design: one dynamic role, driven by the security_user_country table, rather
// than one static role per market. A static design needs a new role and a
// republish every time someone changes territory; the dynamic one needs a row
// in a table that can be refreshed from HR.
//
// security_user_country is left DISCONNECTED - no relationship to anything.
// Relating it to dim_country would work, but the role expressions below read
// it as a table rather than through a filter path, so the relationship would
// buy nothing and add one more edge for a future ambiguity to hide in.
//
// The "*" wildcard row gives head office everything through the same
// mechanism rather than a second unfiltered role, so there is exactly one
// place to look when asking who can see what.
//
// THREE tables need a filter, not one. Filtering dim_country alone secures the
// numbers and leaks the names: dimension tables are not filtered by the fact,
// so a UK analyst would still get all 4,334 customers in a slicer. Each table
// below is filtered in the same role.
// =========================================================================

// Role name: Territory
// -------------------------------------------------------------------------
// Table: dim_country     Filter expression:
/*
VAR Me = USERPRINCIPALNAME ()
VAR Mine =
    CALCULATETABLE (
        VALUES ( security_user_country[Country] ),
        security_user_country[UserEmail] = Me
    )
RETURN
    "*" IN Mine || dim_country[Country] IN Mine
*/

// Table: dim_customer    Filter expression:
// Guests are visible to everyone: the member carries no identity, and hiding
// it would make every territory's revenue disagree with the group total for a
// reason nobody could find.
/*
VAR Me = USERPRINCIPALNAME ()
VAR Mine =
    CALCULATETABLE (
        VALUES ( security_user_country[Country] ),
        security_user_country[UserEmail] = Me
    )
RETURN
    "*" IN Mine || dim_customer[IsGuest] || dim_customer[Country] IN Mine
*/

// Table: security_user_country    Filter expression:
// Hides the mapping table itself from anyone but their own row. Without this
// a user with any access can drop it into a visual and read the whole
// entitlements list - including which accounts hold the wildcard.
/*
security_user_country[UserEmail] = USERPRINCIPALNAME ()
*/

// -------------------------------------------------------------------------
// Test with: Modelling > View as > Other user >
//   uk.analyst@example.com    -> United Kingdom only
//   dach.analyst@example.com  -> Germany, Austria, Switzerland
//   groupbi@example.com       -> everything (wildcard row)
//   nobody@example.com        -> no rows, and every visual should say so
//                                rather than showing a blank canvas
//
// The last case is the one that gets skipped and the one that embarrasses you
// in front of a user: an unmapped account must fail closed AND explain itself.
//
// Check the customer slicer, not just the revenue card, in every one of these.
// The leak that matters is a name appearing where a number correctly does not.
